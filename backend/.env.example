FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://acctsys:acctsys_dev_pw@localhost:5432/acctsys_dev
CORS_ORIGINS=http://localhost:5173

# Bootstraps the first ETG super-admin account via seed.py. Rotate/remove after initial setup.
SUPERADMIN_BOOTSTRAP_EMAIL=admin@etg.example.com
SUPERADMIN_BOOTSTRAP_PASSWORD=change-me

# Base URLs this app is served at -- used to build OAuth redirect URIs
# for the integrations below. In production these should both be your
# real public URL (e.g. https://suite.example.com); in local dev the
# defaults (localhost:5173 / localhost:5000) are used if left unset.
# APP_BASE_URL=http://localhost:5173
# API_BASE_URL=http://localhost:5000

# --- Optional: file storage (contracts/attachments) ---
# Leave S3_BUCKET unset to fall back to local-disk storage under
# backend/storage/ (fine for a single-server deployment; back that
# folder up). Set these to move storage to real S3-compatible object
# storage instead.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# --- Optional: Microsoft 365 / Google Workspace email OAuth ---
# Lets staff connect their own O365/Gmail account under Settings ->
# Integrations so invoices email out as them, not a shared address.
# Unset = that integration reports itself as "not configured" and is
# simply unavailable; nothing else in the app is affected.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: Authorize.net (customer portal online payments) ---
# Unset = the portal's "Pay Now" honestly reports that online payment
# isn't connected, instead of pretending to charge a card.
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_TRANSACTION_KEY=
# AUTHORIZE_NET_PUBLIC_CLIENT_KEY=
# AUTHORIZE_NET_SIGNATURE_KEY=

# --- Optional: waitress (Windows/production WSGI server) tuning ---
# WAITRESS_HOST=127.0.0.1
# WAITRESS_PORT=5000
# WAITRESS_THREADS=8
