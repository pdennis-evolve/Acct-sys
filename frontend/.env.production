# Used by `npm run build`. Relative path (not a hostname) so the built
# app works behind the IIS reverse proxy documented in
# docs/WINDOWS_SERVER_INSTALL.md without any CORS configuration --
# the browser calls /api/* on whatever origin served index.html, and
# IIS forwards those requests to the backend on 127.0.0.1:5000.
VITE_API_URL=/api
